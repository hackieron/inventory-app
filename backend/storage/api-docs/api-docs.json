{
    "openapi": "3.0.0",
    "info": {
        "title": "Personal Inventory API",
        "description": "API for managing personal items, locations, categories, borrowers, and item history.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Local Development Server"
        }
    ],
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Register a new user",
                "operationId": "register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User registered successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login user",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful"
                    },
                    "422": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout user",
                "operationId": "logout",
                "responses": {
                    "200": {
                        "description": "Logout successful"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                }
            }
        },
        "/api/user": {
            "get": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Get authenticated user",
                "operationId": "getAuthenticatedUser",
                "responses": {
                    "200": {
                        "description": "Authenticated user"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                }
            }
        },
        "/api/items/{item}/borrow": {
            "post": {
                "tags": [
                    "Borrowings"
                ],
                "summary": "Borrow an item",
                "description": "Creates a borrowing record for an item owned by the authenticated user.",
                "operationId": "borrowItem",
                "responses": {
                    "201": {
                        "description": "Item borrowed successfully"
                    },
                    "404": {
                        "description": "Item not found"
                    },
                    "409": {
                        "description": "Item is already borrowed"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/borrowings/{borrowing}/return": {
            "post": {
                "tags": [
                    "Borrowings"
                ],
                "summary": "Return an item",
                "description": "Marks an active borrowing as returned.",
                "operationId": "returnItem",
                "responses": {
                    "200": {
                        "description": "Item returned successfully"
                    },
                    "404": {
                        "description": "Borrowing not found"
                    },
                    "409": {
                        "description": "Item has already been returned"
                    }
                }
            }
        },
        "/api/items/{item}/borrowings": {
            "get": {
                "tags": [
                    "Borrowings"
                ],
                "summary": "Get item borrowing history",
                "description": "Returns the borrowing history of an item owned by the authenticated user.",
                "operationId": "getItemBorrowings",
                "responses": {
                    "200": {
                        "description": "Borrowing history retrieved successfully"
                    },
                    "404": {
                        "description": "Item not found"
                    }
                }
            }
        },
        "/api/borrowings": {
            "get": {
                "tags": [
                    "Borrowings"
                ],
                "summary": "Get items borrowed by the authenticated user",
                "description": "Returns all active and previous borrowings where the contact represents the authenticated user.",
                "operationId": "getMyBorrowings",
                "responses": {
                    "200": {
                        "description": "Borrowings retrieved successfully"
                    }
                }
            }
        },
        "/api/borrowings/{borrowing}": {
            "get": {
                "tags": [
                    "Borrowings"
                ],
                "summary": "Get a borrowing",
                "description": "Returns a specific borrowing belonging to an item owned by the authenticated user.",
                "operationId": "getBorrowing",
                "responses": {
                    "200": {
                        "description": "Borrowing retrieved successfully"
                    },
                    "404": {
                        "description": "Borrowing not found"
                    }
                }
            }
        },
        "/api/borrowing-requests/incoming": {
            "get": {
                "tags": [
                    "Borrowing Requests"
                ],
                "summary": "Get incoming borrowing requests",
                "description": "Get borrowing requests received by the authenticated user.\n\nThese are requests for items owned by the authenticated user.",
                "operationId": "getIncomingBorrowingRequests",
                "responses": {
                    "200": {
                        "description": "Incoming borrowing requests retrieved successfully"
                    }
                }
            }
        },
        "/api/borrowing-requests/my": {
            "get": {
                "tags": [
                    "Borrowing Requests"
                ],
                "summary": "Get my borrowing requests",
                "description": "Get borrowing requests made by the authenticated user.",
                "operationId": "getMyBorrowingRequests",
                "responses": {
                    "200": {
                        "description": "Borrowing requests retrieved successfully"
                    }
                }
            }
        },
        "/api/items/{item}/borrowing-request": {
            "post": {
                "tags": [
                    "Borrowing Requests"
                ],
                "summary": "Request to borrow an item",
                "description": "Request to borrow an item.",
                "operationId": "createBorrowingRequest",
                "responses": {
                    "201": {
                        "description": "Borrowing request created successfully"
                    },
                    "403": {
                        "description": "Item is not available for borrowing"
                    },
                    "409": {
                        "description": "A request already exists or item is already borrowed"
                    }
                }
            }
        },
        "/api/borrowing-requests/{borrowingRequest}/approve": {
            "post": {
                "tags": [
                    "Borrowing Requests"
                ],
                "summary": "Approve borrowing request",
                "description": "Approve a borrowing request.\n\nThis creates the actual Borrowing record.",
                "operationId": "approveBorrowingRequest",
                "responses": {
                    "200": {
                        "description": "Borrowing request approved successfully"
                    },
                    "403": {
                        "description": "Unauthorized"
                    },
                    "409": {
                        "description": "Request cannot be approved"
                    }
                }
            }
        },
        "/api/borrowing-requests/{borrowingRequest}/reject": {
            "post": {
                "tags": [
                    "Borrowing Requests"
                ],
                "summary": "Reject borrowing request",
                "description": "Reject a borrowing request.",
                "operationId": "rejectBorrowingRequest",
                "responses": {
                    "200": {
                        "description": "Borrowing request rejected successfully"
                    },
                    "403": {
                        "description": "Unauthorized"
                    },
                    "409": {
                        "description": "Request has already been processed"
                    }
                }
            }
        },
        "/api/borrowing-requests/{borrowingRequest}/cancel": {
            "post": {
                "tags": [
                    "Borrowing Requests"
                ],
                "summary": "Cancel borrowing request",
                "description": "Cancel a borrowing request.\n\nOnly the requester can cancel it.",
                "operationId": "cancelBorrowingRequest",
                "responses": {
                    "200": {
                        "description": "Borrowing request cancelled successfully"
                    },
                    "403": {
                        "description": "Unauthorized"
                    },
                    "409": {
                        "description": "Request has already been processed"
                    }
                }
            }
        },
        "/api/categories": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Get all categories",
                "description": "Returns all inventory categories.",
                "operationId": "getCategories",
                "responses": {
                    "200": {
                        "description": "Categories retrieved successfully"
                    }
                }
            }
        },
        "/api/contacts": {
            "get": {
                "tags": [
                    "Contacts"
                ],
                "summary": "Get all contacts",
                "description": "Returns all contacts belonging to the authenticated user.",
                "operationId": "getContacts",
                "responses": {
                    "200": {
                        "description": "Contacts retrieved successfully"
                    }
                }
            },
            "post": {
                "tags": [
                    "Contacts"
                ],
                "summary": "Create a contact",
                "description": "Creates a contact for the authenticated user.",
                "operationId": "createContact",
                "responses": {
                    "201": {
                        "description": "Contact created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/contacts/{contact}": {
            "get": {
                "tags": [
                    "Contacts"
                ],
                "summary": "Get a contact",
                "description": "Returns a specific contact belonging to the authenticated user.",
                "operationId": "getContact",
                "responses": {
                    "200": {
                        "description": "Contact retrieved successfully"
                    },
                    "404": {
                        "description": "Contact not found"
                    }
                }
            },
            "put": {
                "tags": [
                    "Contacts"
                ],
                "summary": "Update a contact",
                "description": "Updates a contact belonging to the authenticated user.",
                "operationId": "updateContact",
                "responses": {
                    "200": {
                        "description": "Contact updated successfully"
                    },
                    "404": {
                        "description": "Contact not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Contacts"
                ],
                "summary": "Delete a contact",
                "description": "Deletes a contact belonging to the authenticated user.",
                "operationId": "deleteContact",
                "responses": {
                    "200": {
                        "description": "Contact deleted successfully"
                    },
                    "404": {
                        "description": "Contact not found"
                    }
                }
            }
        },
        "/api/auth/google": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Authenticate with Google",
                "operationId": "googleLogin",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "id_token"
                                ],
                                "properties": {
                                    "id_token": {
                                        "description": "Google ID token received from the mobile application",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Google authentication successful"
                    },
                    "401": {
                        "description": "Invalid Google token"
                    }
                }
            }
        },
        "/api/items": {
            "get": {
                "tags": [
                    "Items"
                ],
                "summary": "Get all items",
                "description": "Returns all inventory items belonging to the authenticated user.",
                "operationId": "getItems",
                "responses": {
                    "200": {
                        "description": "Items retrieved successfully"
                    }
                }
            },
            "post": {
                "tags": [
                    "Items"
                ],
                "summary": "Create a new item",
                "description": "Creates a new inventory item for the authenticated user.",
                "operationId": "createItem",
                "responses": {
                    "201": {
                        "description": "Item created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/items/{item}": {
            "get": {
                "tags": [
                    "Items"
                ],
                "summary": "Get a specific item",
                "description": "Returns a specific inventory item belonging to the authenticated user.",
                "operationId": "getItem",
                "responses": {
                    "200": {
                        "description": "Item retrieved successfully"
                    },
                    "404": {
                        "description": "Item not found"
                    }
                }
            },
            "put": {
                "tags": [
                    "Items"
                ],
                "summary": "Update an item",
                "description": "Updates an inventory item belonging to the authenticated user.",
                "operationId": "updateItem",
                "responses": {
                    "200": {
                        "description": "Item updated successfully"
                    },
                    "404": {
                        "description": "Item not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Items"
                ],
                "summary": "Delete an item",
                "description": "Deletes an inventory item belonging to the authenticated user.",
                "operationId": "deleteItem",
                "responses": {
                    "200": {
                        "description": "Item deleted successfully"
                    },
                    "404": {
                        "description": "Item not found"
                    }
                }
            }
        },
        "/api/items/{item}/history": {
            "get": {
                "tags": [
                    "Item History"
                ],
                "summary": "Get item history",
                "description": "Returns the history of an item belonging to the authenticated user.",
                "operationId": "getItemHistory",
                "responses": {
                    "200": {
                        "description": "Item history retrieved successfully"
                    },
                    "404": {
                        "description": "Item not found"
                    }
                }
            }
        },
        "/api/items/{item}/history/{history}": {
            "get": {
                "tags": [
                    "Item History"
                ],
                "summary": "Get a specific history entry",
                "description": "Returns a specific history entry belonging to an item owned by the authenticated user.",
                "operationId": "getItemHistoryEntry",
                "responses": {
                    "200": {
                        "description": "History entry retrieved successfully"
                    },
                    "404": {
                        "description": "History entry not found"
                    }
                }
            }
        },
        "/api/locations": {
            "get": {
                "tags": [
                    "Locations"
                ],
                "summary": "Get all locations",
                "description": "Returns all inventory locations.",
                "operationId": "getLocations",
                "responses": {
                    "200": {
                        "description": "Locations retrieved successfully"
                    }
                }
            }
        },
        "/api/return-requests/incoming": {
            "get": {
                "tags": [
                    "Return Requests"
                ],
                "summary": "Get incoming return requests",
                "description": "Get return requests received by the authenticated user.\n\nThese are requests for items owned by the authenticated user.",
                "operationId": "getIncomingReturnRequests",
                "responses": {
                    "200": {
                        "description": "Incoming return requests retrieved successfully"
                    }
                }
            }
        },
        "/api/return-requests/my": {
            "get": {
                "tags": [
                    "Return Requests"
                ],
                "summary": "Get my return requests",
                "description": "Get return requests made by the authenticated user.",
                "operationId": "getMyReturnRequests",
                "responses": {
                    "200": {
                        "description": "Return requests retrieved successfully"
                    }
                }
            }
        },
        "/api/borrowings/{borrowing}/return-request": {
            "post": {
                "tags": [
                    "Return Requests"
                ],
                "summary": "Request to return an item",
                "description": "Request to return a borrowed item.",
                "operationId": "createReturnRequest",
                "responses": {
                    "201": {
                        "description": "Return request created successfully"
                    },
                    "403": {
                        "description": "Unauthorized"
                    },
                    "409": {
                        "description": "A return request already exists or item is already returned"
                    }
                }
            }
        },
        "/api/return-requests/{returnRequest}/approve": {
            "post": {
                "tags": [
                    "Return Requests"
                ],
                "summary": "Approve return request",
                "description": "Approve a return request.",
                "operationId": "approveReturnRequest",
                "responses": {
                    "200": {
                        "description": "Return request approved successfully"
                    },
                    "403": {
                        "description": "Unauthorized"
                    },
                    "409": {
                        "description": "Request cannot be approved"
                    }
                }
            }
        },
        "/api/return-requests/{returnRequest}/reject": {
            "post": {
                "tags": [
                    "Return Requests"
                ],
                "summary": "Reject return request",
                "description": "Reject a return request.",
                "operationId": "rejectReturnRequest",
                "responses": {
                    "200": {
                        "description": "Return request rejected successfully"
                    },
                    "403": {
                        "description": "Unauthorized"
                    },
                    "409": {
                        "description": "Request has already been processed"
                    }
                }
            }
        },
        "/api/return-requests/{returnRequest}/cancel": {
            "post": {
                "tags": [
                    "Return Requests"
                ],
                "summary": "Cancel return request",
                "description": "Cancel a return request.\n\nOnly the borrower can cancel it.",
                "operationId": "cancelReturnRequest",
                "responses": {
                    "200": {
                        "description": "Return request cancelled successfully"
                    },
                    "403": {
                        "description": "Unauthorized"
                    },
                    "409": {
                        "description": "Request has already been processed"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "Borrowings",
            "description": "Borrowings"
        },
        {
            "name": "Borrowing Requests",
            "description": "Borrowing Requests"
        },
        {
            "name": "Categories",
            "description": "Categories"
        },
        {
            "name": "Contacts",
            "description": "Contacts"
        },
        {
            "name": "Items",
            "description": "Items"
        },
        {
            "name": "Item History",
            "description": "Item History"
        },
        {
            "name": "Locations",
            "description": "Locations"
        },
        {
            "name": "Return Requests",
            "description": "Return Requests"
        }
    ]
}